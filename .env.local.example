# Supabase — copy to .env.local and fill in (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# Server-only, full-privilege key (bypasses RLS). Required after migration
# 0002 locks out anon. NEVER prefix with NEXT_PUBLIC_, never commit the value.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Anthropic API key for AI 初评 (server-only; console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
